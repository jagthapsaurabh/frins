# FRINS environment file
#
# Copy to .env and edit. On a server this file is read by systemd through
# EnvironmentFile; the app itself does not parse it.
# Format: KEY=value, no quotes, no "export".

# ---------------------------------------------------------------- required
NODE_ENV=production
PORT=3100

# ---------------------------------------------------------------- optional
# Only needed if the UI is served from a different origin than the API.
# Comma separated list. Leave unset when one process serves both.
# CORS_ORIGIN=https://frins.in

# ---------------------------------------------------------------- AI pipeline
# mock  = deterministic three-agent pipeline, no network calls (default)
# real  = call an OpenAI-compatible endpoint, with deterministic fallback
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# ---------------------------------------------------------------- training APIs
# Service key accepted in the x-frins-guide-key header for
# /api/ai/training/* and /api/ai/benchmark/run.
# Leave unset in production to require a signed-in GUIDE/ADMIN session instead.
# GUIDE_REVIEW_API_KEY=

# ---------------------------------------------------------------- notes
# The SQLite file always lives at <project>/data/frins.db. There is no path
# variable, so start the process from the project root.
