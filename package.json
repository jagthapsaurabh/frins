{
  "name": "frins-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "FRINS: The Market Learning Ecosystem (React + Express + SQLite, no Prisma)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "db:reset": "tsx server/reset-db.ts",
    "create:admin": "tsx server/create-admin.ts",
    "create:user": "tsx server/create-admin.ts --role LEARNER",
    "list:accounts": "tsx server/create-admin.ts --list",
    "purge:demo": "tsx server/purge-demo-accounts.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
